ARCENAL_SOCKET=/run/__APP__/app.sock
ARCENAL_APP_ID=__APP__
ARCENAL_ORIGIN=https://__DOMAIN__
ARCENAL_BASE_PATH=__PATH__
ARCENAL_DATA_DIR=__DATA_DIR__
ARCENAL_SIGNING_KEY=__SIGNING_KEY__
ARCENAL_PROXY_KEY=__PROXY_KEY__
PGUSER=__DB_USER__
PGPASSWORD=__DB_PWD__
PGDATABASE=__DB_NAME__
# Optional protected server-side Hermes configuration; not included in profiles/browser.
HERMES_URL=
HERMES_TOKEN=
