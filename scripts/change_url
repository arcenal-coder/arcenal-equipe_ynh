#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Mise à jour de l’adresse d’ARCenal Équipe..."
ynh_systemctl --service="$app" --action=stop
ynh_config_change_url_nginx
chmod 600 "/etc/nginx/conf.d/$domain.d/$app.conf"
chown root:root "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_replace --match="^ARCENAL_ORIGIN=.*" --replace="ARCENAL_ORIGIN=https://$domain" --file="$install_dir/config/server.env"
ynh_replace --match="^ARCENAL_BASE_PATH=.*" --replace="ARCENAL_BASE_PATH=$path" --file="$install_dir/config/server.env"
ynh_store_file_checksum "$install_dir/config/server.env"
ynh_systemctl --service="$app" --action=start
ynh_systemctl --service=nginx --action=reload
ynh_script_progression "Nouvelle adresse configurée."
